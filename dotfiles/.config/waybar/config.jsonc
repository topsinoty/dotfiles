{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "battery",
    "clock",
    "tray"
  ],
  "sway/workspaces": {
    "format": "{name}"
  },
  "sway/mode": {
    "format": "  MODE  {}  "
  },
  "sway/window": {
    "format": "{title}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "ON",
      "deactivated": "OFF"
    }
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL MUTE"
  },
  "network": {
    "format-wifi": "NET {signalStrength}%",
    "format-ethernet": "NET LAN",
    "format-disconnected": "NET DOWN"
  },
  "cpu": {
    "format": "CPU {usage}%"
  },
  "memory": {
    "format": "MEM {percentage}%"
  },
  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "BAT +{capacity}%",
    "format-full": "BAT FULL",
    "format-alt": "{time}"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  }
}
