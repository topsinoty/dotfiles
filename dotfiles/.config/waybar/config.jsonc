{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "sway/language",
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "clock",
    "tray"
  ],
  "sway/workspaces": {
    "format": "{name}"
  },
  "sway/mode": {
    "format": "  MODE  {}  "
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 50
  },
  "sway/language": {
    "format": "{short}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "ON",
      "deactivated": "OFF"
    }
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL MUTE",
    "tooltip-format": "{desc}",
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "NET {signalStrength}%",
    "format-ethernet": "NET LAN",
    "format-disconnected": "NET DOWN",
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}\nUP {bandwidthUpBytes}  DOWN {bandwidthDownBytes}",
    "tooltip-format-wifi": "{essid}  {ipaddr}/{cidr}\nUP {bandwidthUpBytes}  DOWN {bandwidthDownBytes}",
    "on-click": "nm-connection-editor"
  },
  "cpu": {
    "format": "CPU {usage}%",
    "states": {
      "warning": 70,
      "critical": 85
    }
  },
  "memory": {
    "format": "MEM {percentage}%",
    "tooltip-format": "RAM {used:0.1f}/{total:0.1f}G\nSWAP {swapUsed:0.1f}/{swapTotal:0.1f}G",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  "temperature": {
    "format": "TEMP {temperatureC}°C",
    "critical-threshold": 80,
    "tooltip": false
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰁹 FULL",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}  {power}W",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  }
}
