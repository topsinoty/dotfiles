#!/bin/sh

# Keep PipeWire microphone actions and the hardware mute indicator in agreement.
set -eu

log_event()
{
    logger --tag dotfiles-microphone -- "$1" || true
}

read_mute_state()
{
    if ! volume=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@); then
        log_event 'microphone state could not be read'
        return 1
    fi

    case $volume in
        *'[MUTED]'*)
            printf '%s\n' muted
            ;;
        *)
            printf '%s\n' unmuted
            ;;
    esac
}

find_mute_light()
{
    for path in /sys/class/leds/*::micmute/brightness; do
        [ -e "$path" ] || continue

        device=${path%/brightness}
        printf '%s\n' "${device##*/}"
        return 0
    done

    return 1
}

set_mute_light()
{
    light=$(find_mute_light) || return 0

    state=$(read_mute_state) || return 1

    case $state in
        muted)
            brightness=1
            ;;
        unmuted)
            brightness=0
            ;;
    esac

    if brightnessctl --quiet \
        --class=leds \
        --device="$light" \
        set "$brightness"
    then
        log_event "microphone is $state; mute light synchronized"
    else
        log_event "microphone is $state; mute light could not be changed"
        return 1
    fi
}

toggle_mute()
{
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    set_mute_light
}

case ${1:-} in
    sync)
        set_mute_light
        ;;
    toggle)
        toggle_mute
        ;;
    *)
        printf 'usage: %s sync|toggle\n' "${0##*/}" >&2
        exit 2
        ;;
esac
