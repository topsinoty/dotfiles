#!/bin/sh

# Save screenshots and mirror them to the Wayland clipboard.
set -eu

mode=${1:-full}
if command -v xdg-user-dir >/dev/null 2>&1; then
    pictures=$(xdg-user-dir PICTURES)
fi

pictures=${pictures:-$HOME/Pictures}
directory=$pictures/Screenshots
timestamp=$(date +%Y%m%d-%H%M%S)

mkdir -p "$directory"

case $mode in
    full)
        file=$directory/screenshot-full-$timestamp.png
        grim "$file"
        ;;
    region)
        geometry=$(slurp) || exit 0
        [ -n "$geometry" ] || exit 0

        file=$directory/screenshot-region-$timestamp.png
        grim -g "$geometry" "$file"
        ;;
    *)
        printf 'usage: %s [full|region]\n' "$0" >&2
        exit 2
        ;;
esac

wl-copy --type image/png < "$file"
notify-send --transient --expire-time=4000 "Screenshot saved" "$file"
