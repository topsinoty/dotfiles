#!/bin/sh

# Save screenshots and mirror them to the Wayland clipboard.
set -eu

mode=${1:-full}
directory=$HOME/Pictures/Screenshots
timestamp=$(date +%Y%m%d-%H%M%S)

mkdir -p "$directory"

case $mode in
    full)
        file=$directory/screenshot-full-$timestamp.png
        grim "$file"
        ;;
    region)
        geometry=$(slurp) || exit 0
        [ -n "$geometry" ] || exit 0

        file=$directory/screenshot-region-$timestamp.png
        grim -g "$geometry" "$file"
        ;;
    *)
        printf 'usage: %s [full|region]\n' "$0" >&2
        exit 2
        ;;
esac

wl-copy --type image/png < "$file"
notify-send "Screenshot saved" "$file"
