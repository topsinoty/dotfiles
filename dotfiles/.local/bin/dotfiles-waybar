#!/bin/sh

# Keep exactly one Waybar process for the active compositor.
set -eu

compositor=${1:-sway}
config=$HOME/.config/waybar/$compositor.jsonc

case $compositor in
    sway | niri)
        ;;
    *)
        printf 'unsupported Waybar compositor: %s\n' "$compositor" >&2
        exit 2
        ;;
esac

pkill --uid "$(id -u)" --full --exact "waybar --config $config" || true

exec waybar --config "$config"
