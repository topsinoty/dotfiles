#!/bin/sh

# Store user-provided coordinates locally.
set -eu

log_event()
{
    logger --tag dotfiles-location-setup -- "$1" || true
}

validate_coordinate()
{
    value=$1
    minimum=$2
    maximum=$3

    if ! printf '%s\n' "$value" |
        grep --extended-regexp --quiet \
            '^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)$'
    then
        return 1
    fi

    awk \
        -v value="$value" \
        -v minimum="$minimum" \
        -v maximum="$maximum" \
        'BEGIN {
            if (value < minimum) {
                exit 1
            }

            if (value > maximum) {
                exit 1
            }

            exit 0
        }'
}

read_location()
{
    printf 'Latitude: '
    read -r latitude

    printf 'Longitude: '
    read -r longitude
}

save_location()
{
    mkdir -p "${config%/*}"
    umask 077

    {
        printf 'latitude=%s\n' "$latitude"
        printf 'longitude=%s\n' "$longitude"
    } > "$config"
}

config=${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/location.env
log_event 'using manual location entry'
read_location

if ! validate_coordinate "$latitude" -90 90; then
    log_event 'rejected an invalid latitude'
    printf '%s\n' 'latitude must be between -90 and 90' >&2
    exit 1
fi

if ! validate_coordinate "$longitude" -180 180; then
    log_event 'rejected an invalid longitude'
    printf '%s\n' 'longitude must be between -180 and 180' >&2
    exit 1
fi

save_location
printf 'Saved %s\n' "$config"
log_event 'saved confirmed coordinates'
