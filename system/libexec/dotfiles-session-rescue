#!/bin/sh

# Show Wlogout when the active Wayland compositor responds.
# Otherwise, terminate only the active local graphical session.
set -u

PATH=/usr/sbin:/usr/bin
export PATH

log_event()
{
    logger --tag dotfiles-session-rescue -- "$1" || true
}

if [ "$(id -u)" -ne 0 ]; then
    log_event 'refused an unprivileged invocation'
    printf '%s\n' 'dotfiles-session-rescue must run as root' >&2
    exit 1
fi

# Ignore repeated key presses until the current rescue attempt finishes.
umask 077
exec 9>/run/dotfiles-session-rescue.lock
flock -n 9 || exit 0
log_event 'rescue requested'

session=
session_type=
session_user=
session_uid=
runtime=
bus=

get_session_property()
{
    session_id=$1
    property=$2

    value=$(loginctl show-session "$session_id" \
        --property="$property" \
        --value) || value=

    printf '%s\n' "$value"
}

list_seats()
{
    loginctl list-seats --no-legend |
        while read -r seat _; do
            [ -n "$seat" ] || continue
            printf '%s\n' "$seat"
        done
}

accept_session()
{
    if [ "$remote" != no ]; then
        return 1
    fi

    case $candidate_type in
        wayland | x11)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

find_active_graphical_session()
{
    for seat in $(list_seats); do
        candidate=$(loginctl show-seat "$seat" \
            --property=ActiveSession \
            --value) || candidate=

        [ -n "$candidate" ] || continue

        remote=$(get_session_property "$candidate" Remote)
        candidate_type=$(get_session_property "$candidate" Type)

        if ! accept_session; then
            continue
        fi

        session=$candidate
        session_type=$candidate_type
        return 0
    done

    return 1
}

load_session_identity()
{
    session_user=$(get_session_property "$session" Name)
    [ -n "$session_user" ] || return 1

    session_uid=$(id -u "$session_user") || session_uid=

    [ -n "$session_uid" ] || return 1

    runtime=/run/user/$session_uid
    bus=unix:path=$runtime/bus
}

run_as_session_user()
{
    runuser -u "$session_user" -- env \
        XDG_RUNTIME_DIR="$runtime" \
        DBUS_SESSION_BUS_ADDRESS="$bus" \
        "$@"
}

open_wlogout_with_sway()
{
    command -v swaymsg >/dev/null 2>&1 || return 1

    for socket in "$runtime"/sway-ipc."$session_uid".*.sock; do
        [ -S "$socket" ] || continue

        if ! run_as_session_user timeout 2 env \
            SWAYSOCK="$socket" \
            swaymsg --socket "$socket" --type get_version >/dev/null 2>&1
        then
            continue
        fi

        log_event "asking Sway to open Wlogout for session $session"

        if run_as_session_user timeout 2 env \
            SWAYSOCK="$socket" \
            swaymsg --quiet --socket "$socket" exec wlogout
        then
            return 0
        fi

        log_event "Sway failed to open Wlogout for session $session"
    done

    return 1
}

open_wlogout_with_niri()
{
    command -v niri >/dev/null 2>&1 || return 1

    for socket in "$runtime"/niri.*.sock; do
        [ -S "$socket" ] || continue

        if ! run_as_session_user timeout 2 env \
            NIRI_SOCKET="$socket" \
            niri msg version >/dev/null 2>&1
        then
            continue
        fi

        log_event "asking Niri to open Wlogout for session $session"

        if run_as_session_user timeout 2 env \
            NIRI_SOCKET="$socket" \
            niri msg action spawn -- wlogout
        then
            return 0
        fi

        log_event "Niri failed to open Wlogout for session $session"
    done

    return 1
}

open_wlogout()
{
    [ "$session_type" = wayland ] || return 1

    if ! command -v wlogout >/dev/null 2>&1; then
        log_event 'Wlogout is unavailable'
        return 1
    fi

    open_wlogout_with_sway && return 0
    open_wlogout_with_niri && return 0

    return 1
}

if ! find_active_graphical_session; then
    log_event 'no active local graphical session found'
    exit 0
fi

if ! load_session_identity; then
    log_event "could not resolve the identity of session $session"
    exit 0
fi

log_event "selected $session_type session $session"

if open_wlogout; then
    log_event "Wlogout opened for session $session"
    exit 0
fi

log_event "terminating unresponsive session $session"
if ! loginctl terminate-session "$session"; then
    log_event "failed to terminate session $session"
    exit 1
fi

log_event "terminated session $session"
